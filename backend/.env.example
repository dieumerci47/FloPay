# ── Serveur ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Base de données ───────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/umg_paytech"

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_very_long_random_secret_key
JWT_EXPIRES_IN=7d

# ── PawaPay ───────────────────────────────────────────────────────────────────
PAWAPAY_API_TOKEN=your_pawapay_api_token_here
PAWAPAY_BASE_URL=https://api.sandbox.pawapay.cloud   # sandbox
# PAWAPAY_BASE_URL=https://api.pawapay.cloud         # production

# ── App ───────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ── PDFs ──────────────────────────────────────────────────────────────────────
PDF_OUTPUT_DIR=./storage/receipts
