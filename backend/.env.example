# ── Serveur ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Base de données ───────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/umg_paytech"

# ── JWT / Sessions admin ──────────────────────────────────────────────────────
# Access token court (header Bearer, gardé en mémoire côté client)
JWT_ACCESS_SECRET=change_this_to_a_very_long_random_secret_key
ACCESS_TOKEN_TTL=15m
# Refresh token (cookie httpOnly) — durée de vie en jours
REFRESH_TOKEN_TTL_DAYS=7
# Compat : ancien nom encore accepté en repli
JWT_SECRET=change_this_to_a_very_long_random_secret_key
JWT_EXPIRES_IN=7d

# ── PawaPay ───────────────────────────────────────────────────────────────────
PAWAPAY_API_TOKEN=your_pawapay_api_token_here
PAWAPAY_BASE_URL=https://api.sandbox.pawapay.cloud   # sandbox
# PAWAPAY_BASE_URL=https://api.pawapay.cloud         # production

# Vérification de la signature des callbacks (RFC 9421).
# Toujours appliquée si NODE_ENV=production. Mettre à "true" pour l'exiger aussi en dev.
PAWAPAY_VERIFY_SIGNATURE=false
# Host public utilisé pour reconstruire l'URL signée (utile derrière un proxy/ngrok
# si Host/X-Forwarded-Host n'est pas fiable). Ex: dugout-cornbread.ngrok-free.dev
# PAWAPAY_CALLBACK_HOST=

# ── App ───────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ── PDFs ──────────────────────────────────────────────────────────────────────
PDF_OUTPUT_DIR=./storage/receipts

# URL de base encodée dans le QR de vérification (page publique frontend)
RECEIPT_VERIFY_BASE=http://localhost:5173/verifier

# ── Cron de réconciliation (filet de sécurité des paiements PENDING) ──────────
RECONCILE_CRON_ENABLED=true        # "false" pour désactiver
RECONCILE_CRON_INTERVAL_MIN=5      # fréquence d'un passage
RECONCILE_MIN_AGE_MIN=2            # ignore les paiements trop récents (laisse le webhook agir)
RECONCILE_MAX_AGE_HOURS=48         # ignore les paiements trop vieux (abandonnés)
RECONCILE_BATCH=50                 # nb max de paiements traités par passage

# ── Rétention du journal d'audit ──────────────────────────────────────────────
AUDIT_RETENTION_ENABLED=true       # "false" pour désactiver la purge
AUDIT_RETENTION_MONTHS=12          # conserve les N derniers mois de logs
