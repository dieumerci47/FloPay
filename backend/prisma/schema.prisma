// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Etablissements ───────────────────────────────────────────────────────────
model Establishment {
  id        String    @id @default(uuid())
  name      String
  code      String    @unique  // ex: "FST", "FLLASH", "FDSE"
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  programs  Program[]
  students  Student[]
  admins    Admin[]

  @@map("establishments")
}

// ─── Niveaux (cycles) avec leur montant ───────────────────────────────────────
model Level {
  id        String    @id @default(uuid())
  name      String    @unique               // "Licence", "Master", "Doctorat"
  amount    Decimal   @db.Decimal(10, 2)     // frais de scolarité du cycle
  years     Int       @default(3)            // nb d'années du cycle (Licence=3, Master=2)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  programs  Program[]

  @@map("levels")
}

// ─── Parcours par établissement ───────────────────────────────────────────────
model Program {
  id              String   @id @default(uuid())
  name            String                          // ex: "Physique", "Informatique"
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  levelId         String
  level           Level    @relation(fields: [levelId], references: [id])
  students        Student[]
  payments        Payment[]

  @@map("programs")
}

// ─── Etudiants ────────────────────────────────────────────────────────────────
model Student {
  id              String   @id @default(uuid())
  matricule       String   @unique     // identifiant interne auto-généré (jamais saisi par l'étudiant)
  lastName        String                // Nom
  firstName       String                // Prénom(s)
  gender          Gender                // Sexe
  birthDate       DateTime?
  birthPlace      String?
  phone           String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  programId       String
  program         Program @relation(fields: [programId], references: [id])
  payments        Payment[]

  @@map("students")
}

// ─── Paiements ────────────────────────────────────────────────────────────────
model Payment {
  id                   String        @id @default(uuid())
  receiptNumber        String        @unique  // N° déclaration de recette
  amount               Decimal       @db.Decimal(10, 2)
  currency             String        @default("XAF")
  paymentMethod        PaymentMethod
  phoneNumber          String        // numéro mobile money
  status               PaymentStatus @default(PENDING)
  academicYear         String
  studyYear            Int           @default(1)  // année dans le cycle (1=L1/M1, 2=L2/M2…)

  // PawaPay
  pawapayDepositId     String?       @unique
  pawapayStatus        String?
  pawapayFailureReason String?       // message d'origine (détail)
  pawapayFailureCode   String?       // code d'échec stable (ex: INSUFFICIENT_BALANCE)

  // Timestamps
  paidAt               DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  studentId            String
  student              Student  @relation(fields: [studentId], references: [id])
  programId            String
  program              Program  @relation(fields: [programId], references: [id])
  receipt              Receipt?

  @@map("payments")
}

// ─── Reçus générés ────────────────────────────────────────────────────────────
model Receipt {
  id          String   @id @default(uuid())
  pdfPath     String                       // chemin vers le fichier PDF
  generatedAt DateTime @default(now())

  paymentId   String   @unique
  payment     Payment  @relation(fields: [paymentId], references: [id])

  @@map("receipts")
}

// ─── Admins (scolarité) ───────────────────────────────────────────────────────
model Admin {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  fullName     String
  role         AdminRole @default(ESTABLISHMENT_ADMIN)
  isActive     Boolean   @default(true)

  // Cloisonnement multi-tenant :
  //   null  → SUPER_ADMIN (supervision globale, tous les établissements)
  //   défini → admin rattaché à UN établissement (ne voit que le sien)
  establishmentId String?
  establishment   Establishment? @relation(fields: [establishmentId], references: [id])

  // Sécurité — protection anti brute-force
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@map("admins")
}

// ─── Refresh tokens (rotation, stockés hashés) ────────────────────────────────
model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique   // SHA-256 du token — jamais stocké en clair
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  adminId   String
  admin     Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("refresh_tokens")
}

// ─── Journal d'audit (traçabilité des actions admin) ──────────────────────────
model AuditLog {
  id         String   @id @default(uuid())
  action     String                 // LOGIN, LOGOUT, VERIFY_RECEIPT, CREATE_ADMIN…
  targetType String?                // Payment, Student, Admin…
  targetId   String?
  detail     String?
  ip         String?
  createdAt  DateTime @default(now())

  adminId    String?
  admin      Admin?   @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Enums ────────────────────────────────────────────────────────────────────
enum Gender {
  M
  F
}

enum PaymentMethod {
  MTN
  AIRTEL
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum AdminRole {
  SUPER_ADMIN
  ESTABLISHMENT_ADMIN
}
